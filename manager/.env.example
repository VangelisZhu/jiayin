# Copy to .env (never commit .env). Use absolute paths that exist on YOUR NAS.
MUSIC_PATH=/path/to/music
DATA_PATH=/path/to/jiayin-manager-data
# Safe default. Set to your NAS LAN IP to allow access from other LAN devices.
BIND_IP=127.0.0.1
# Replace before first launch. No shared/default password ships with the application.
JIAYIN_ADMIN_PASSWORD=
PUID=1000
PGID=1000
# Set only when accessing through your own HTTPS reverse proxy.
JIAYIN_PUBLIC_ORIGIN=
